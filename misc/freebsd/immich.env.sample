# Copy to /usr/local/etc/immich.env and adjust.
# See https://docs.immich.app/install/environment-variables for all options.

# Where uploads, thumbnails and encoded videos are stored
IMMICH_MEDIA_LOCATION=/var/db/immich/data

IMMICH_HOST=0.0.0.0
IMMICH_PORT=2283

DB_HOSTNAME=127.0.0.1
DB_PORT=5432
DB_USERNAME=immich
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich
# Uses VectorChord (postgresql18-vchord) by default. To use plain pgvector
# instead, uncomment:
# DB_VECTOR_EXTENSION=pgvector

REDIS_HOSTNAME=127.0.0.1
REDIS_PORT=6379

# The machine-learning service is not part of this bundle. Point this at an
# immich-machine-learning container running elsewhere, or turn machine learning
# off in Administration > Settings.
# IMMICH_MACHINE_LEARNING_URL=http://ml-host:3003
